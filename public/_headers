# Keep Cloudflare production aliases and preview URLs out of search results.
# Canonical custom domains do not match these host patterns.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Search data supports the library interface; the guides are the indexed pages.
/search-index.json
  X-Robots-Tag: noindex
