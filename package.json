{
  "name": "aiguardrails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "verify": "npm run check && npm test && npm run build && npm run audit",
    "audit:live": "node scripts/audit-live.mjs"
  },
  "dependencies": {
    "astro": "7.4.8",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "linkedom": "0.18.12"
  }
}
