---
import type { CollectionEntry } from "astro:content";
import { readingMinutes, topicId } from "../lib/guide-text";
interface Props {
  guides: CollectionEntry<"guides">[];
  compact?: boolean;
}
const { guides, compact = false } = Astro.props;
---

<div class:list={["guide-list", { compact }]}>
  {guides.map((guide, index) => (
    <a
      class="guide-row"
      href={"/guides/" + guide.id + "/"}
      data-guide={guide.id}
      data-topic={topicId(guide.data.category)}
      data-search={[
        guide.data.title,
        guide.data.description,
        guide.data.answer,
        guide.data.category,
        guide.data.primaryKeyword,
        ...guide.data.relatedKeywords,
      ]
        .join(" ")
        .toLowerCase()}
    >
      <span class="guide-number" aria-hidden="true">
        {String(index + 1).padStart(2, "0")}
      </span>
      <div class="guide-row-body">
        <span class="guide-meta">
          {guide.data.category}
          <span aria-hidden="true"> / </span>
          {readingMinutes(guide.body || "", guide.data.answer)} min read
        </span>
        <h3>{guide.data.title}</h3>
        {!compact && <p>{guide.data.description}</p>}
        {!compact && <p class="search-excerpt" hidden></p>}
      </div>
      <span class="row-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  ))}
</div>
