---
import Base from "../../layouts/Base.astro";
import GuideList from "../../components/GuideList.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { site } from "../../site";
import { readingMinutes, topicId } from "../../lib/guide-text";
export async function getStaticPaths() {
  return (await getCollection("guides")).map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}
interface Props {
  guide: CollectionEntry<"guides">;
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const all = await getCollection("guides");
const related = guide.data.related
  .map((id) => all.find((g) => g.id === id))
  .filter((g): g is CollectionEntry<"guides"> => Boolean(g));
const minutes = readingMinutes(guide.body || "", guide.data.answer);
const sections = headings.filter((h) => h.depth === 2 || h.depth === 3);
const reviewed = new Date(
  guide.data.reviewedDate + "T12:00:00Z",
).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const canonical = site.origin + "/guides/" + guide.id + "/";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.data.title,
    description: guide.data.description,
    mainEntityOfPage: canonical,
    dateModified: guide.data.reviewedDate,
    author: {
      "@type": "Organization",
      name: site.name,
      url: site.origin + "/",
    },
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: site.origin + "/",
    },
    image: site.origin + "/social.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: site.name,
        item: site.origin + "/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Guides",
        item: site.origin + "/guides/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: guide.data.title,
        item: canonical,
      },
    ],
  },
];
---

<Base
  title={guide.data.title + " | " + site.name}
  description={guide.data.description}
  schema={schema}
>
  <div class="article-topline wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">{site.name}</a>
      <span aria-hidden="true">/</span>
      <a href="/guides/">Guides</a>
      <span aria-hidden="true">/</span>
      <a href={"/guides/?topic=" + topicId(guide.data.category)}>
        {guide.data.category}
      </a>
    </nav>
    <a class="text-link" href={"/text/" + guide.id + ".md"} download>
      Download Markdown ↓
    </a>
  </div>
  <div class="article-shell wrap">
    <aside class="article-nav" aria-label="Article sections">
      <p class="eyebrow">On this page</p>
      <nav aria-label="Table of contents">
        <a href="#answer">In brief</a>
        {sections.map((h) => (
          <a class:list={[{ subsection: h.depth === 3 }]} href={"#" + h.slug}>
            {h.text}
          </a>
        ))}
        <a href="#source-documents">Sources & citation</a>
      </nav>
      <a class="back-to-library" href="/guides/">
        ← Explore the library
      </a>
    </aside>
    <article>
      <header class="article-header">
        <p class="eyebrow">
          {guide.data.category} / {minutes} min read
        </p>
        <h1>{guide.data.title}</h1>
        <p class="byline">
          By <a href="/about/">{site.name}</a>
          <span>
            Reviewed <time datetime={guide.data.reviewedDate}>{reviewed}</time>
          </span>
        </p>
      </header>
      <section
        class="article-answer"
        id="answer"
        aria-labelledby="answer-label"
      >
        <p class="eyebrow" id="answer-label">
          In brief
        </p>
        <p>{guide.data.answer}</p>
      </section>
      <details class="mobile-toc">
        <summary>
          On this page{" "}
          <span>{headings.filter((h) => h.depth === 2).length} sections</span>
        </summary>
        <nav aria-label="Mobile table of contents">
          {sections.map((h) => (
            <a class:list={[{ subsection: h.depth === 3 }]} href={"#" + h.slug}>
              {h.text}
            </a>
          ))}
          <a href="#source-documents">Sources & citation</a>
        </nav>
      </details>
      <div class="prose">
        <Content />
      </div>
      <section class="sources" id="source-documents">
        <p class="eyebrow">Check the evidence</p>
        <h2>Sources & citation</h2>
        <ol>
          {guide.data.sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ol>
        <div class="citation-box">
          <p id="article-citation">
            {site.name}. “{guide.data.title}.” Reviewed {reviewed}.{" "}
            <a href={canonical}>{canonical}</a>
          </p>
          <button class="quiet-button" type="button" id="copy-citation">
            Copy citation
          </button>
          <span id="citation-status" role="status"></span>
        </div>
      </section>
      <section class="article-next">
        <p class="eyebrow">The next useful step</p>
        <h2>Keep reading</h2>
        <GuideList guides={related} compact />
      </section>
    </article>
  </div>
</Base>
<script>
  const copy = document.querySelector<HTMLButtonElement>("#copy-citation");
  copy?.addEventListener("click", async () => {
    const status = document.querySelector<HTMLElement>("#citation-status")!;
    try {
      await navigator.clipboard.writeText(
        document
          .querySelector("#article-citation")!
          .textContent!.replace(/\s+/g, " ")
          .trim(),
      );
      status.textContent = "Citation copied.";
    } catch {
      status.textContent =
        "Copy is unavailable. Select the citation text above.";
    }
  });
</script>
