---
import Base from "../../layouts/Base.astro";
import GuideList from "../../components/GuideList.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { site } from "../../site";
export async function getStaticPaths() {
  return (await getCollection("guides")).map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}
interface Props {
  guide: CollectionEntry<"guides">;
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const all = await getCollection("guides");
const related = guide.data.related
  .map((id) => all.find((g) => g.id === id))
  .filter((g): g is CollectionEntry<"guides"> => Boolean(g));
const words = (guide.body || "").split(/\s+/).length;
const canonical = site.origin + "/guides/" + guide.id + "/";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.data.title,
    description: guide.data.description,
    mainEntityOfPage: canonical,
    dateModified: guide.data.reviewedDate,
    author: {
      "@type": "Organization",
      name: "Emisar",
      url: "https://emisar.dev/",
    },
    publisher: {
      "@type": "Organization",
      name: "Emisar",
      url: "https://emisar.dev/",
    },
    image: site.origin + "/social.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: site.name,
        item: site.origin + "/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Guides",
        item: site.origin + "/guides/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: guide.data.title,
        item: canonical,
      },
    ],
  },
];
---

<Base
  title={guide.data.title + " | " + site.name}
  description={guide.data.description}
  schema={schema}
>
  <div class="article-shell wrap">
    <aside class="article-nav">
      <a href="/guides/">← All guides</a>
      <p class="eyebrow">On this page</p>
      <nav aria-label="Table of contents">
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={"#" + h.slug}>{h.text}</a>
          ))}
      </nav>
      <a class="download-link" href={"/text/" + guide.id + ".md"} download>
        Download Markdown ↓
      </a>
    </aside>
    <article>
      <header class="article-header">
        <span class="category">{guide.data.category}</span>
        <h1>{guide.data.title}</h1>
        <p class="lede">{guide.data.description}</p>
        <p class="byline">
          By <a href="/about/">Emisar</a>
          <span>
            Reviewed{" "}
            <time datetime={guide.data.reviewedDate}>
              {new Date(
                guide.data.reviewedDate + "T12:00:00Z",
              ).toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                timeZone: "UTC",
              })}
            </time>
          </span>
          <span>{Math.max(1, Math.ceil(words / 220))} min read</span>
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <section class="sources">
        <h2>Source documents</h2>
        <ul>
          {guide.data.sources.map((s) => (
            <li>
              <a href={s.url}>{s.title}</a>
            </li>
          ))}
        </ul>
      </section>
      <section class="article-next">
        <h2>Keep reading</h2>
        <GuideList guides={related} compact />
      </section>
      <aside class="product-note">
        <p class="eyebrow">From our team</p>
        <h2>Put a boundary around the agent’s work</h2>
        <p>
          Emisar controls remote infrastructure actions. co:op limits a coding
          agent’s local environment. Ryker brings an AI teammate into
          engineering conversations.
        </p>
        <a href="/tools-we-build/">See where each tool fits ↗</a>
      </aside>
    </article>
  </div>
</Base>
