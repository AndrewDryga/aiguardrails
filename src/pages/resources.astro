---
import Base from "../layouts/Base.astro";
import { site } from "../site";
const guardrails = site.theme === "guardrails";
const resources: {
  title: string;
  type: string;
  text: string;
  href: string;
  guide?: string;
}[] = guardrails
  ? [
      {
        title: "Synthetic guardrail cases",
        type: "JSON · test adapter input",
        text: "Inputs, expected decisions and observations for a small test suite. Supply an adapter for your own application; no test results are invented.",
        href: "/resources/guardrail-cases.json",
        guide: "ai-guardrails-testing",
      },
      {
        title: "Detector evaluation sheet",
        type: "CSV · editable worksheet",
        text: "Keep detector verdicts, expected labels and incomplete observations together when comparing a threshold.",
        href: "/resources/detector-evaluation.csv",
        guide: "prompt-injection-detection",
      },
      {
        title: "Red-team engagement plan",
        type: "Markdown · editable plan",
        text: "Define the permitted target, prohibited effects, test conditions, stopping rules and evidence before a red-team exercise.",
        href: "/resources/red-team-engagement.md",
        guide: "llm-red-teaming",
      },
      {
        title: "Guardrail review worksheet",
        type: "Markdown · editable",
        text: "A working checklist for boundaries, failure tests, evidence and recovery. Add a link to the evidence behind each checked item.",
        href: "/downloads/guardrail-review.md",
      },
      {
        title: "Policy lab test cases",
        type: "JSON · example fixtures",
        text: "Allowed, held and denied requests for the policy lab. Use them to inspect rule order, then write cases for your own policy.",
        href: "/downloads/policy-test-cases.json",
      },
    ]
  : [
      {
        title: "Agent release review",
        type: "Markdown · editable worksheet",
        text: "Record the owner, scope, required evidence, unresolved gaps and decision for one agent release.",
        href: "/resources/agent-release-review.md",
        guide: "ai-governance-checklist",
      },
      {
        title: "Detailed agent inventory",
        type: "CSV · editable worksheet",
        text: "Connect deployments, identities, permissions, owners and revocation paths. Verify the record against the running configuration.",
        href: "/resources/agent-inventory-expanded.csv",
        guide: "ai-agent-inventory",
      },
      {
        title: "Monitoring signal dictionary",
        type: "CSV · editable definitions",
        text: "Define each signal’s unit, denominator, owner and response. Choose thresholds from your own operating evidence.",
        href: "/resources/agent-monitoring-signals.csv",
        guide: "ai-agent-monitoring",
      },
      {
        title: "Governance tool evaluation",
        type: "CSV · trial worksheet",
        text: "Match a required capability to documentation, trial evidence, integration work and the person responsible for it.",
        href: "/resources/governance-tool-evaluation.csv",
        guide: "ai-governance-tools",
      },
      {
        title: "Governance capability review",
        type: "CSV · evidence worksheet",
        text: "Review capabilities separately, retain failed or missing evidence, and choose the next concrete improvement.",
        href: "/resources/governance-capability-review.csv",
        guide: "ai-governance-maturity-model",
      },
      {
        title: "Agent lifecycle review",
        type: "Markdown · editable worksheet",
        text: "Carry ownership and evidence through design, approval, deployment, change and retirement.",
        href: "/resources/agent-lifecycle-review.md",
        guide: "ai-agent-lifecycle",
      },
      {
        title: "Agent evaluation cases",
        type: "JSON · test adapter input",
        text: "Separate useful work, permission, approval, unknown outcomes and interrupted execution in a synthetic evaluation suite.",
        href: "/resources/agent-evaluation-cases.json",
        guide: "ai-agent-evaluation",
      },
      {
        title: "Agent governance policy",
        type: "Markdown · editable",
        text: "A starting policy covering scope, approval, enforcement, evidence, incidents and expiring exceptions.",
        href: "/downloads/agent-governance-policy.md",
      },
      {
        title: "Starter agent inventory",
        type: "CSV · blank template",
        text: "Track each agent’s owner, job, tools, credentials, data access, revocation path and review date.",
        href: "/downloads/agent-inventory.csv",
      },
      {
        title: "Audit record example",
        type: "JSON · example only",
        text: "An example of linked request, decision and result fields. Choose the fields your workflow needs and keep sensitive payloads out.",
        href: "/downloads/audit-record-example.json",
      },
    ];
---

<Base
  title={"Templates and downloads | " + site.name}
  description={
    "Download practical " +
    site.name.toLowerCase() +
    " checklists and examples. Editable resources with explanations and no signup."
  }
>
  <section class="page-intro wrap">
    <p class="eyebrow">Working resources</p>
    <h1>
      Templates and examples
      <br />
      you can use
    </h1>
    <p class="lede">
      Download a copy, adapt it to your system and record the evidence behind
      your decisions. No signup.
    </p>
  </section>
  <section class="resource-grid wrap">
    {resources.map((r) => (
      <article class="resource">
        <p class="eyebrow">{r.type}</p>
        <h2>{r.title}</h2>
        <p>{r.text}</p>
        <div class="resource-actions">
          <a href={r.href} download>
            Download ↓
          </a>
          {r.guide && <a href={"/guides/" + r.guide + "/"}>Read the guide ↗</a>}
        </div>
      </article>
    ))}
  </section>
  <section class="wrap narrow prose">
    <h2>Use the example with its limits</h2>
    <p>
      A document describes a rule. Your system still has to enforce it. Before
      using a template in production, check the identity, exact action, target
      and failure behavior in your own environment.
    </p>
    <p>
      Every guide also has a Markdown download.{" "}
      <a href="/guides/">Find a guide</a> or{" "}
      <a href={"/tools/" + site.tool + "/"}>{site.toolLabel.toLowerCase()}</a>.
    </p>
  </section>
</Base>
